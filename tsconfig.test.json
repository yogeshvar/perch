{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "@testing-library/jest-dom"]
  },
  "include": ["test/**/*.ts", "test/**/*.tsx", "vitest.config.mts", "electron/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "scripts/**/*.mjs"]
}
