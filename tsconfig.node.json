{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "outDir": "dist-types/node"
  },
  "include": ["electron/**/*.ts", "src/shared/**/*.ts", "electron.vite.config.ts"]
}
